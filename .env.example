# Copie ce fichier en .env et complete les valeurs (le .env n'est PAS versionne).
# En production (GitHub Actions), ces valeurs viennent des GitHub Secrets.

# --- SMTP (OVH) ---
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=587
SMTP_SECURITY=starttls          # ssl | starttls | none
SMTP_USER=noreply@whitetelecom.fr

# !!! NE JAMAIS committer ce mot de passe : a mettre uniquement ici (.env local)
# et dans GitHub Secrets sous le nom SMTP_PASSWORD.
SMTP_PASSWORD=

# --- Adresses mail ---
MAIL_FROM=noreply@whitetelecom.fr
MAIL_TO=Auger939@gmail.com

# --- Options ---
# Mettre a 1 pour envoyer un mail de test au demarrage (verifier le SMTP).
SEND_TEST_EMAIL=0
# Niveau de log: DEBUG, INFO, WARNING
LOG_LEVEL=INFO
